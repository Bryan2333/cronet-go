+void InMemoryPrefStore::ReadPrefsAsync(ReadErrorDelegate* error_delegate) {
+  delete error_delegate;
+}
+
+void InMemoryPrefStore::ReportValueChanged(std::string_view key,
+                                           uint32_t flags) {
