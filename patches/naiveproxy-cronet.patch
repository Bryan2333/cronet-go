+#ifndef COMPONENTS_CRONET_ANDROID_TEST_TEST_SERVER_EMBEDDED_TEST_SERVER_ADAPTER_H_
+#define COMPONENTS_CRONET_ANDROID_TEST_TEST_SERVER_EMBEDDED_TEST_SERVER_ADAPTER_H_
+
+#include <jni.h>
+
+#include <string>
+#include <vector>
+
