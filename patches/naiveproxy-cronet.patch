diff --git a/src/components/cronet/android/api/src/org/chromium/net/apihelpers/ContentTypeParametersParser.java b/src/components/cronet/android/api/src/org/chromium/net/apihelpers/ContentTypeParametersParser.java
new file mode 100644
index 00000000..b4eea016
--- /dev/null
