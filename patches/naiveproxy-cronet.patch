+    observers_.NotifyAllowReentrancy(&PrefStore::Observer::OnPrefValueChanged,
+                                     key);
+  }
+}
+
+void ValueMapPrefStore::RemoveValue(std::string_view key, uint32_t flags) {
+  if (prefs_.RemoveValue(key)) {
+    observers_.NotifyAllowReentrancy(&PrefStore::Observer::OnPrefValueChanged,
+                                     key);
+  }
+}
