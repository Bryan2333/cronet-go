+                UrlRequest.Builder urlRequestBuilder =
+                        cronetEngine.newUrlRequestBuilder(mUrl, mCallback, mCallback.getExecutor());
+                urlRequestBuilder.build().start();
+                mCallback.blockForDone();
+            } finally {
+                cronetEngine.shutdown();
