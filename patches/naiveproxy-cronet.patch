+  auto* metrics = Cronet_RequestFinishedInfo_metrics_get(request_info);
+  EXPECT_EQ(kSentByteCount, Cronet_Metrics_sent_byte_count_get(metrics));
+  EXPECT_NE(nullptr, url_response_info);
