+                                            "HostResolverRules",
+                                            new JSONObject()
+                                                    .put(
+                                                            "host_resolver_rules",
+                                                            "MAP "
+                                                                    + EXPECTED_IDN_ASCII
+                                                                    + " 127.0.0.1"))
+                                    .toString());
+                });
