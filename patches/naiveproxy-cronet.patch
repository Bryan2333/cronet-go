+              std::make_unique<net::test_server::RawHttpResponse>(
+                  cronet::Java_NativeTestServer_getRawHttpResponseHeaders(
+                      env, java_raw_http_response),
+                  cronet::Java_NativeTestServer_getRawHttpResponseContents(
+                      env, java_raw_http_response))};
