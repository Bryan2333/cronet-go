+
+        @Override
+        public void run() {
+            mRunBlocker.block();
+            ExperimentalCronetEngine cronetEngine =
+                    mTestRule
+                            .getTestFramework()
+                            .createNewSecondaryBuilder(mTestRule.getTestFramework().getContext())
+                            .build();
+            try {
