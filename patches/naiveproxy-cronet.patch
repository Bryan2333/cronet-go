+# This target is not intended to be a functional APK. Instead, it is used to
+# ensure that the jars we are shipping to downstream users can successfully go
+# through R8/D8 on their own, that our ProGuard configs are valid, and that the
+# resulting APK is free of unresolved references or duplicate classes (i.e. same
+# class being shipped in multiple jars).
+template("cronet_package_apk") {
+  android_apk(target_name) {
+    forward_variables_from(invoker, "*", TESTONLY_AND_VISIBILITY)
+
+    android_manifest = "//build/android/AndroidManifest.xml"
+
+    # ProGuard is what checks for undefined references, so we need to enable it
+    # for the checking to actually happen. Also, this nicely doubles as a basic
+    # check for our ProGuard configs.
+    proguard_enabled = true
+
+    # Disable the trace_references check, which is an additional Chromium safety
+    # check that ensures the resulting DEX does not contain unresolved
+    # references. The reason why we disable this check is because it does not
+    # consider -dontwarn rules from ProGuard configs, and will therefore fail.
+    # Note that even with this check disabled, R8 itself will still check for
+    # unresolved references.
+    enable_proguard_checks = false
+
+    if (use_jacoco_coverage) {
+      # Normally this would be done for us, see:
+      #   https://source.chromium.org/chromium/chromium/src/+/main:build/config/android/internal_rules.gni;l=3592-3601;drc=a250d23f8414193856f12bfe4a334329e0c26368
+      # However this only kicks in if sources are provided. We don't provide any
+      # in this target, and nothing we depend on bundles this dep (it was stripped
+      # from Cronet classes during repackaging), so we have to re-add this dep
+      # manually.
+      deps += [ "//third_party/jacoco:jacocoagent_java" ]
+    }
+  }
