+    private <T> T getOrDefault(String option, T defaultValue, Class<T> clazz) {
+        if (mJson.length() == 0) {
+            return defaultValue;
+        }
+
+        T value = defaultValue;
+        try {
+            value = clazz.cast(mJson.get(option));
+        } catch (JSONException | ClassCastException e) {
+            if (Log.isLoggable(TAG, Log.VERBOSE)) {
