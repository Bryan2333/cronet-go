+# Dependencies of cronet_package_without_native_apk that are not bundled within
+# the final Cronet jars that we are shipping to downstream users; instead, we
+# expect users to pull these themselves.
+#
+# Note: in general, only //third_party dependencies are expected here. If you
+# find yourself adding a non-third-party dependency to this list, you probably
+# want to ship the dependency in Cronet jars instead (see also "deps_to_package"
+# lists).
+#
+# CAUTION: this list must be kept in sync with the mechanisms that are used to
+# specify Cronet external dependencies (e.g. Google internal repo, Maven POM
+# files), otherwise users may end up with missing references, or pull
+# unnecessary dependencies. Also, be aware that users may be pulling versions of
+# these dependencies that are different from the versions currently in Chromium.
+cronet_package_without_nativejava_external_deps = [
+  # TODO(https://crbug.com/469672624): we should jarjar and bundle protobuf, as
+  # downstream users may end up pulling a version of protobuf that doesn't match
+  # the generated code.
+  "//third_party/android_deps:protobuf_lite_runtime_java",
+  "//third_party/androidx:androidx_annotation_annotation_experimental_java",
+  "//third_party/androidx:androidx_annotation_annotation_java",
+]
