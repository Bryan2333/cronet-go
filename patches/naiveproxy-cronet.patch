+        // Write first.
+        callback.waitForNextWriteStep(); // onStreamReady
+        for (int i = 0; i < testData.length; i++) {
+            // Write next chunk of test data.
+            callback.startNextWrite(stream);
+            callback.waitForNextWriteStep(); // onWriteCompleted
