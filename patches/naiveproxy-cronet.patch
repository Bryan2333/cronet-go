+        assertThat(stream.isDone()).isFalse();
+
+        final ConditionVariable streamDestroyed = new ConditionVariable(false);
+        stream.setOnDestroyedCallbackForTesting(
+                new Runnable() {
+                    @Override
+                    public void run() {
+                        streamDestroyed.open();
