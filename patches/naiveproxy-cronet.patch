+        for (UrlRequest request : requests) {
+            request.start();
+        }
+        for (UrlRequest request : requests) {
+            request.cancel();
+        }
+        for (TestUrlRequestCallback callback : callbacks) {
+            callback.blockForDone();
+        }
+    }
