+
+    @Test
+    @SmallTest
+    public void testPostWithoutContentLengthWriteOneByte() throws Exception {
+        URL url = new URL(mNativeTestServer.getEchoBodyURL());
+        mConnection = (HttpURLConnection) mCronetEngine.openConnection(url);
