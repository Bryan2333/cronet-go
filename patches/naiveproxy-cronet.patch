+            mNetworkQualityThread =
+                    new Thread(
+                            new Runnable() {
+                                @Override
+                                public void run() {
+                                    StrictMode.ThreadPolicy threadPolicy =
+                                            StrictMode.getThreadPolicy();
+                                    try {
