+    @Override
+    public void followRedirect() {
+        transitionStates(
+                State.AWAITING_FOLLOW_REDIRECT,
+                State.STARTED,
+                new Runnable() {
+                    @Override
+                    public void run() {
+                        mCurrentUrl = mPendingRedirectUrl;
+                        mPendingRedirectUrl = null;
+                        fireOpenConnection();
+                    }
+                });
+    }
