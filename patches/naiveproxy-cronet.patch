+           ":package_impl_native_java",
+           ":package_shared_java",
+         ] + cronet_package_with_nativejava_external_deps
+  proguard_configs = [
+    "cronet_shared_proguard.cfg",
+    "cronet_impl_common_proguard.cfg",
