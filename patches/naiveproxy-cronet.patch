+    create_license_post_processing(
+        Mapper("License", ['dtoa', 'BSD-3-Clause', 'Apache-2.0'],
+               ["Apache 2.0", "BSD-3-Clause"])),
+}
+
+# This is relative to the repo_directory passed in |update_license|
+IGNORED_README = {
