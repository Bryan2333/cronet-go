+        @Nullable
+        public Long getFreshLookupTimeoutMillis() {
+            return mFreshLookupTimeoutMillis;
+        }
+
+        @Nullable
+        public Long getMaxExpiredDelayMillis() {
+            return mMaxExpiredDelayMillis;
+        }
+
+        @Nullable
+        public Boolean getAllowCrossNetworkUsage() {
