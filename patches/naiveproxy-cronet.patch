+                self.defines = set()
+                self.include_dirs = set()
+                self.deps = set()
+                self.transitive_static_libs_deps = set()
+                self.ldflags = []
+                # These are valid only for type == 'action'
+                self.inputs = set()
+                self.outputs = set()
+                self.args = []
+                self.response_file_contents = ''
+                self.rust_flags = list()
+                self.libs = set()
+
+        def __init__(self, name, gn_type):
