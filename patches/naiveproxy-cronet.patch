+    ReportValueChanged(key, flags);
+}
+
+void InMemoryPrefStore::SetValueSilently(std::string_view key,
+                                         base::Value value,
+                                         uint32_t flags) {
+  prefs_.SetValue(key, std::move(value));
+}
