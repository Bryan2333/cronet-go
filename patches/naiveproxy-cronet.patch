+     * once for each stream.
+     */
+    @SuppressWarnings("unused")
+    @CalledByNative
+    private void onResponseHeadersReceived(
+            int httpStatusCode,
+            String negotiatedProtocol,
+            String[] headers,
+            long receivedByteCount,
+            @JniType("std::string") String proxyServer,
+            @JniType("bool") boolean isProxied) {
+        try {
+            mResponseInfo =
+                    prepareResponseInfoOnNetworkThread(
+                            httpStatusCode,
+                            negotiatedProtocol,
+                            headers,
+                            receivedByteCount,
+                            proxyServer,
+                            isProxied);
+        } catch (Exception e) {
+            failWithException(new CronetExceptionImpl("Cannot prepare ResponseInfo", null));
+            return;
+        }
+        postTaskToExecutor(
+                new Runnable() {
+                    @Override
+                    public void run() {
+                        synchronized (mNativeStreamLock) {
+                            if (isDoneLocked()) {
+                                return;
+                            }
+                            mReadState = State.WAITING_FOR_READ;
+                        }
+
+                        try {
+                            mCallback.onResponseHeadersReceived(
+                                    CronetBidirectionalStream.this, mResponseInfo);
