+# This will combine all the proguard configs found through the
+# transitive dependencies of those targets.
+template("collect_proguard_configs") {
+  _build_config_target = "${target_name}__build_config"
+  _build_config = "$target_gen_dir/${target_name}.build_config.json"
+
+  _deps = [
+    ":cronet_build_config_java",
+    ":cronet_jni_registration_java",
+    ":repackage_api",
+    ":repackage_native_impl",
+  ]
+  write_build_config(_build_config_target) {
+    type = "dist_jar"
+    build_config = _build_config
+    requires_android = true
+    proguard_enabled = true
+    config_deps = _deps
+  }
+
+  action(target_name) {
+    script = "//components/cronet/tools/generate_proguard_file.py"
+
+    outputs = [ invoker.output ]
+    sources = [ _build_config ]
+    depfile = "$target_out_dir/$target_name.d"
+    deps = _deps + [ ":$_build_config_target" ]
+    args = [
+      "--output_file",
+      rebase_path(invoker.output, root_build_dir),
+      "--dep_file",
+      rebase_path(depfile, root_build_dir),
+      rebase_path(_build_config, root_build_dir),
+    ]
+    if (invoker.aosp_mode) {
+      args += [ "--aosp-mode" ]
+    }
+  }
+}
