+  # Make sure not to depend on :cronet so we don't accidentally load it in the
+  # tests, this is especially tricky because we manipulate a global state in the
+  # CronetLibraryLoader to load a different shared library, adding this
+  # assert_no_deps will ensure that there'll only be a single shared library and
+  # any mistake will be caught immediately when trying to load the libraries.
+  assert_no_deps = [ ":cronet" ]
