+class Cronet_EngineImpl::StreamEngineImpl : public stream_engine {
+ public:
+  explicit StreamEngineImpl(net::URLRequestContextGetter* context_getter) {
+    context_getter_ = context_getter;
+    obj = context_getter_.get();
+    annotation = nullptr;
+  }
+
+  ~StreamEngineImpl() {
