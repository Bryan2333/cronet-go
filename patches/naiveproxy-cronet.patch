+        TestUrlRequestCallback callback = new TestUrlRequestCallback();
+        testFramework
+                .startEngine()
+                .newUrlRequestBuilder(
+                        "https://" + IDN_UNICODE + ":" + Http2TestServer.getServerPort() + "/",
+                        callback,
+                        callback.getExecutor())
+                .build()
+                .start();
+        callback.blockForDone();
+        return callback;
+    }
