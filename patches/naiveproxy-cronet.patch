+        // TODO(crbug.com/40284777): When not explicitly enabled, fall back to MockCertVerifier if
+        // custom CAs are not supported.
+        if (useMockCertVerifier || Build.VERSION.SDK_INT <= Build.VERSION_CODES.M) {
